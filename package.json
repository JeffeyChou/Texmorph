{
  "name": "texmorph-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm build && pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run packages/core/test packages/mathjax/test/frame-rate.test.ts",
    "docs:dev": "pnpm build && vitepress dev docs",
    "docs:build": "pnpm build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@texmorph/core": "workspace:*",
    "@texmorph/dom": "workspace:*",
    "@texmorph/katex": "workspace:*",
    "@texmorph/mathjax": "workspace:*",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "katex": "0.19.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
