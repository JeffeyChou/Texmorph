{
  "name": "@texmorph/mathjax",
  "version": "0.0.0",
  "description": "MathJax (SVG) renderer for texmorph and createMorph().",
  "license": "MIT",
  "author": "Jiefeng Zhou",
  "homepage": "https://jeffeychou.github.io/Texmorph/api/mathjax",
  "bugs": {
    "url": "https://github.com/JeffeyChou/Texmorph/issues"
  },
  "keywords": [
    "mathjax",
    "math",
    "latex",
    "animation",
    "morph",
    "svg"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffeyChou/Texmorph.git",
    "directory": "packages/mathjax"
  },
  "dependencies": {
    "@texmorph/core": "workspace:*",
    "@texmorph/dom": "workspace:*"
  },
  "peerDependencies": {
    "@mathjax/src": "^4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3"
  },
  "devDependencies": {
    "@mathjax/src": "4.1.3",
    "@mathjax/mathjax-newcm-font": "4.1.3"
  },
  "peerDependenciesMeta": {
    "@mathjax/mathjax-newcm-font": {
      "optional": true
    }
  }
}
