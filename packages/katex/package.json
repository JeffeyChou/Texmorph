{
  "name": "@texmorph/katex",
  "version": "0.1.0",
  "description": "KaTeX renderer for texmorph and createMorph().",
  "license": "MIT",
  "author": "Jiefeng Zhou",
  "homepage": "https://jeffeychou.github.io/Texmorph/api/katex",
  "bugs": {
    "url": "https://github.com/JeffeyChou/Texmorph/issues"
  },
  "keywords": [
    "katex",
    "math",
    "latex",
    "animation",
    "morph",
    "formula"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffeyChou/Texmorph.git",
    "directory": "packages/katex"
  },
  "dependencies": {
    "@texmorph/core": "workspace:*",
    "@texmorph/dom": "workspace:*"
  },
  "peerDependencies": {
    "katex": ">=0.16.11 <0.20"
  },
  "devDependencies": {
    "katex": "0.19.0"
  },
  "unpkg": "./dist/texmorph.iife.js",
  "jsdelivr": "./dist/texmorph.iife.js"
}
