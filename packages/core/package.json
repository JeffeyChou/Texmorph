{
  "name": "@texmorph/core",
  "version": "0.1.0",
  "description": "Pure TypeScript formula-morph planning: tokens, matching, plans and seekable sampling.",
  "license": "MIT",
  "author": "Jiefeng Zhou",
  "homepage": "https://jeffeychou.github.io/Texmorph/api/core",
  "bugs": {
