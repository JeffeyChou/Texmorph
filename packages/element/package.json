{
  "name": "@texmorph/element",
  "version": "0.0.0",
  "description": "<tex-morph> Web Component for texmorph.",
  "license": "MIT",
  "author": "Jiefeng Zhou",
  "homepage": "https://jeffeychou.github.io/Texmorph/api/element",
  "bugs": {
    "url": "https://github.com/JeffeyChou/Texmorph/issues"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "math",
    "latex",
    "animation",
    "morph"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffeyChou/Texmorph.git",
    "directory": "packages/element"
  },
  "dependencies": {
    "@texmorph/core": "workspace:*",
    "@texmorph/dom": "workspace:*"
  },
  "devDependencies": {
    "@texmorph/katex": "workspace:*",
    "katex": "0.19.0"
  }
}
